<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="640.0" spacing="20.0" style="-fx-background-color: #a99cff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SuccessController">

    <children>
        <Label text="Success!" textFill="#1e1c2d">
            <font>
                <Font name="Bookman Old Style Bold" size="32.0" />
            </font></Label>

        <Label fx:id="wordLabel" text="Word was:" textFill="#1e1c2d">
            <font>
                <Font name="Consolas" size="20.0" />
            </font></Label>

        <Label fx:id="scoreLabel" text="Score change:" textFill="#1e1c2d">
            <font>
                <Font name="Consolas" size="18.0" />
            </font></Label>

        <Button onAction="#collectWord" prefHeight="40.0" prefWidth="180.0" text="Collect Word">
         <font>
            <Font name="Bookman Old Style Bold" size="12.0" />
         </font></Button>

        <Label fx:id="messageLabel" style="-fx-font-size: 14px;" text="" textFill="#1e1c2d">
         <font>
            <Font name="Consolas" size="12.0" />
         </font></Label>

        <Button onAction="#continueToLeaderboard" prefHeight="40.0" prefWidth="180.0" text="Continue" textFill="#1e1c2d">
            <font>
                <Font name="Bookman Old Style Bold" size="12.0" />
            </font></Button>
    </children>
</VBox>
