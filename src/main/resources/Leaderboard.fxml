<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="449.0" prefWidth="648.0" style="-fx-background-color: #edc3c3;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LeaderboardController">
   <children>
      <Label alignment="BOTTOM_CENTER" prefHeight="64.0" prefWidth="648.0" style="-fx-background-color: #d82525;" text="Leaderboard" textFill="#fffbed">
         <font>
            <Font name="Bookman Old Style Bold" size="26.0" />
         </font>
      </Label>

      <!-- Replaces score1, score2, score3 labels -->
      <TableView fx:id="leaderboard" layoutX="124.0" layoutY="90.0" prefHeight="280.0" prefWidth="400.0">
         <columns>
            <TableColumn fx:id="rankCol" prefWidth="60.0" text="Rank" />
            <TableColumn fx:id="nameCol" prefWidth="200.0" text="Player" />
            <TableColumn fx:id="scoreCol" prefWidth="140.0" text="High Score" />
         </columns>
      </TableView>
      <Button fx:id="returnBtn" layoutX="296.0" layoutY="385.0" mnemonicParsing="false" onAction="#returnButtonClicked" text="Return">
         <font>
            <Font name="Bookman Old Style" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
