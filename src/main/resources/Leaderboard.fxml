            <Font size="26.0" />
         </font>
      </Label>
      <Label fx:id="score1" alignment="TOP_CENTER" layoutX="248.0" layoutY="128.0" prefHeight="22.0" prefWidth="153.0" style="-fx-background-color: grey;" text="(User1) (HighScore)">
         <font>
            <Font name="AppleGothic Regular" size="13.0" />
         </font></Label>
      <Label fx:id="score2" alignment="TOP_CENTER" layoutX="248.0" layoutY="175.0" prefHeight="22.0" prefWidth="153.0" style="-fx-background-color: grey;" text="(User2) (HighScore)">
         <font>
            <Font name="AppleGothic Regular" size="13.0" />
         </font></Label>
      <Label fx:id="score3" alignment="TOP_CENTER" layoutX="248.0" layoutY="225.0" prefHeight="22.0" prefWidth="153.0" style="-fx-background-color: grey;" text="(User3) (HighScore)">
         <font>
            <Font name="AppleGothic Regular" size="13.0" />
         </font></Label>
      <Button fx:id="returnBtn" layoutX="297.0" layoutY="312.0" mnemonicParsing="false" onAction="#returnButtonClicked" text="Return" />
